{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--viewport-size",
        "430x932",
        "--console-level",
        "warning",
        "--allowed-hosts",
        "localhost,127.0.0.1",
        "--caps",
        "vision"
      ],
      "enabled": true,
      "timeout": 120000
    }
  }
}
