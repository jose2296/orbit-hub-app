# Dependencies
node_modules/
.npm/

# Build output
dist/
build/
*.tsbuildinfo
.esbuild/

# Expo / Metro
.expo/
.expo-shared/
web-build/
expo-env.d.ts
.metro-health-check*
.metro-*

