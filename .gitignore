# Dependencies
node_modules/
.npm/

# Build output
dist/
build/
*.tsbuildinfo
.esbuild/

# Expo / Metro
.expo/
.expo-shared/
web-build/
expo-env.d.ts
.metro-health-check*
.metro-*

# The skill registry cache and the index it writes. It is regenerated on demand
# and it is not part of the app, and it was stopping `release.sh` at its clean
# tree guard: `git status --porcelain` returns anything at all, and the guard does
# not ask what it found. Ignoring it is better than passing `--allow-dirty`,
# which exists to *test* the upload and skips the check that the AAB corresponds
# to a commit someone could rebuild.
.atl/

# Environment files (never commit real secrets)
.env
.env.*
!.env.example
!.env.*.example

# Native credentials
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.cer
*.der
google-services.json
GoogleService-Info.plist

# Logs & debug
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*
*.log

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Test output
coverage/
.nyc_output/
test-results/
playwright-report/
# Artefactos del navegador de pruebas: capturas, trazas y ficheros subidos para
# comprobar un flujo a mano. Son la evidencia de una comprobación, no la
# comprobación: los scripts de `scripts/verify-*.mjs` son lo que se versiona.
#
# Playwright escribe con `--filename` relativo al directorio de trabajo, así que una
# captura hecha a mano cae en la raíz del repositorio y no dentro de
# `.playwright-mcp/`. Estos dos patrones cubren ese caso, que ya se coló en un commit.
.playwright-mcp/
verify/
capturas/
regresion/
orbit-*.png
*-prod.png

# Local databases and dumps
.data/
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# Generated native folders (managed by EAS / CNG)
/apps/mobile/ios
/apps/mobile/android

# Android signing material. La clave de subida de Play no va en el repo bajo
# ningún concepto: quien la tiene puede subir una versión firmada como tú.
/apps/mobile/keys/
*.jks
*.keystore
# JSON de la cuenta de servicio de Google Play
play-service-account*.json
*service-account*.json

# Worktrees de git y su raton de progreso. Un worktree noIgnored acaba con el
# arbol entero dentro del repo, y el ledger de un plan es de ese plan, no de
# nadie.
/.worktrees/
/.superpowers/

# Capturas de depuracion sueltas en la raiz: se guardan en capturas/, que ya
# esta ignorado, y estas se colaron por estar a un nivel de mas.
web-*.png

# pnpm no lee el campo "workspaces" de package.json: instalarlo aqui deja un
# lockfile que no cubre ningun workspace y un node_modules roto. El manager es
# npm, cuyo lock (package-lock.json) si está versionado.
pnpm-lock.yaml
