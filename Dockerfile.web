# syntax=docker/dockerfile:1

# OrbitHub web.
#
# A different service from the API, and a different image. The API is a Node
# server; this is 94 static files and a router with no room to be clever. Railway
# gets one image per service, so the web export is built inside this container
# rather than copied from the repository.
#
# The context is the repository root because `npm ci` here is an npm workspaces
# install: the app's package.json depends on `@orbit-hub/contracts` and
# `@orbit-hub/config` as local workspaces, and a lockfile that does not see them
# is a lockfile npm refuses.

# ------------------------------------------------------------------- build --

FROM node:22-slim AS build

WORKDIR /repo
ENV npm_config_update_notifier=false

# Metro inlines `EXPO_PUBLIC_*` into the bundle while it exports, and Docker does
# **not** hand a build-time variable to a `RUN` unless the stage asks for it by
# name. These two lines are the whole reason the first deployed build pointed at
# `http://localhost:4000`: the variables were set in Railway, the platform passed
# them in, and the build never saw them because nobody declared them. An `ENV`
# would not have worked either — it would have shadowed the passed value with an
# empty one, which is the same bug wearing a different hat.
ARG EXPO_PUBLIC_API_URL
ARG EXPO_PUBLIC_WEB_ORIGIN
ARG EXPO_PUBLIC_GOOGLE_CLIENT_ID
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL
ENV EXPO_PUBLIC_WEB_ORIGIN=$EXPO_PUBLIC_WEB_ORIGIN
ENV EXPO_PUBLIC_GOOGLE_CLIENT_ID=$EXPO_PUBLIC_GOOGLE_CLIENT_ID

# Fails the build instead of shipping an app that cannot reach its own API, or one
# with a disabled sign-in button and no hint why.
#
# `resolveBaseUrl()` falls back to `http://localhost:4000/api/v1` when the variable
# is absent, which is right on a laptop and catastrophic in a deployment: the bundle
# is valid, the build is green, the page loads, and every request goes to whatever
# machine is looking at it. Nothing downstream complains, because from the browser's
# point of view a connection refused is a normal network error.
#
# The Google client id is checked for the same reason and fails the other way: its
# absence renders a **disabled button that looks finished**.
COPY scripts/assert-export-env.mjs scripts/
RUN node scripts/assert-export-env.mjs

# Manifests on their own, so this layer survives a change to any source file.
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/mobile/package.json apps/mobile/package.json
COPY apps/api/package.json apps/api/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/config/package.json packages/config/package.json

# `apps/api` is here as a manifest and nothing more: its manifest has to exist
# for the workspace graph to resolve, but none of its code is needed.
RUN npm ci --workspace @orbit-hub/mobile --workspace @orbit-hub/contracts --workspace @orbit-hub/config

COPY packages/contracts/ packages/contracts/
COPY packages/config/ packages/config/
COPY apps/mobile/ apps/mobile/

# `export:web` ya no es `expo export` a pelo: lo envuelve
# `scripts/export-web.mjs`, que es quien deja el `<title>` puesto en el HTML
# exportado. Sin esta copia el contenedor falla en el `RUN` de abajo con
# `MODULE_NOT_FOUND`, y el fallo dice algo de `scripts/` —no dice que faltaba un
# fichero que la linea de al lado de arriba parecia copiar entera.
COPY scripts/export-web.mjs scripts/

# Contracts and config first, and for the same reason as the API image: Metro
# resolves them through `dist`, and a stale package builds into a bundle that
# disagrees with the server about what a list item is.
RUN npm run build:packages \
 && npm run export:web --workspace @orbit-hub/mobile

# The last chance to catch it, and the check that actually looks at the artefact
# rather than at the intent. Metro ran a few lines above; this reads what it wrote.
# Passing the first check and failing this one means the bundler ignored the
# variables, which is worth knowing about rather than deploying.
RUN node scripts/assert-export-env.mjs --after apps/mobile/dist

# ----------------------------------------------------------------- runtime --

FROM nginx:1.27-alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/mobile/dist /usr/share/nginx/html

# nginx:alpine serves as root and drops to nginx for the workers, so it can bind
# :8080 without the privilege bit that Railway does not grant.
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]