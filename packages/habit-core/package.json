{
  "name": "@orbit-hub/habit-core",
  "version": "0.1.0",
  "private": true,
  "description": "Timezone-aware recurrence engine for habits, shared between the OrbitHub app and API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike:verify": "node scripts/verify-spike.mjs"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
