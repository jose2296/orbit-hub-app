# API environment. Copy to `.env` with: make -C apps/api env-init
# `.env` is git ignored. Never commit it.
#
# With no DATABASE_URL and no PGLITE_DATA_DIR, development falls back to an
# embedded Postgres in .data/pglite, so `make dev` works on a clean clone.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Allowed web origins, comma separated. Native clients send no Origin header.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Database ---------------------------------------------------------------
# Required in production. Leave empty to use the embedded database locally.
DATABASE_URL=
DATABASE_SSL=false
# Embedded Postgres (PGlite) data directory. Leave empty to use DATABASE_URL.
PGLITE_DATA_DIR=

# --- Auth -------------------------------------------------------------------
# Signing key for access tokens. Mandatory in production (32+ characters).
# In development a random one is generated at boot, which resets sessions on
# every restart. Generate a stable one with: make -C apps/api env-jwt
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Google OAuth. Secrets never leave the API. The same client id also goes in
# apps/mobile/.env as EXPO_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ------------------------------------------------------------------
# console  logs the message instead of sending it
# resend   sends for real through https://resend.com
# noop     used by the test suite
# The API refuses to boot with resend and no key, and refuses production with console.
EMAIL_TRANSPORT=console
# From resend.com/api-keys. Looks like re_...
RESEND_API_KEY=
# Must be a sender on a domain you verified in resend.com/domains
EMAIL_FROM=no-reply@orbithub.com
WEB_ORIGIN=https://app.orbithub.com

# --- Rate limiting ----------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
AUTH_ACCOUNT_RATE_LIMIT_MAX=5

# --- Realtime (Phase 5) -----------------------------------------------------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_SECRET=

# --- Catalog providers (Phase 3) ---------------------------------------------
# These live in the API on purpose: the app never holds a provider key.
TMDB_API_KEY=
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_SEARCH_ENGINE_ID=
