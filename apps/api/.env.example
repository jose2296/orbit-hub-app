# API environment. Copy to `.env` and fill in real values. Never commit `.env`.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Allowed web origins, comma separated. Native clients send no Origin header.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# External PostgreSQL instance.
DATABASE_URL=postgresql://user:password@host:5432/orbit_hub
DATABASE_SSL=false

LOG_LEVEL=info

# Token lifetimes (seconds). Access tokens are short lived on purpose.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Google OAuth. Secrets never leave the API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EMAIL_FROM=no-reply@orbithub.app
