# API environment. Copy to `.env` and fill in real values. Never commit `.env`.
# With no DATABASE_URL and no PGLITE_DATA_DIR, development falls back to an
# embedded Postgres in .data/pglite so `npm run api` works on a clean clone.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Allowed web origins, comma separated. Native clients send no Origin header.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# External PostgreSQL instance. Required in production.
DATABASE_URL=postgresql://user:password@host:5432/orbit_hub
DATABASE_SSL=false

# Embedded Postgres (PGlite) for local development. Leave empty to use
# DATABASE_URL. Remove the directory to reset the local database.
PGLITE_DATA_DIR=

LOG_LEVEL=info

# Auth. JWT_SECRET is mandatory in production (32+ characters); in development
# a random one is generated at boot, which invalidates sessions on restart.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Google OAuth. Secrets never leave the API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. `console` logs the message in development; `noop` is for tests.
EMAIL_TRANSPORT=console
EMAIL_FROM=no-reply@orbithub.app
WEB_ORIGIN=https://app.orbithub.com

# Auth throttling. Defaults are strict; tests raise them.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
AUTH_ACCOUNT_RATE_LIMIT_MAX=5
