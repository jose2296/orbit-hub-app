# App environment. Copy to `.env` with: make -C apps/mobile env-init
# `.env` is git ignored. Never commit it.
#
# Everything here is PUBLIC: Expo inlines EXPO_PUBLIC_* into the JavaScript
# bundle. A secret behind one of these names would be readable by anyone.

# Base URL of the OrbitHub API, including the version prefix.
# Android emulator: 10.0.2.2 instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Google OAuth web client id. Public by design; the secret stays in the API.
# The button stays disabled while this is empty.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=orbithub://auth/google
