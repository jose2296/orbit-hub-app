# Public, inlined at build time by Expo. Never put a secret behind EXPO_PUBLIC_*.

# Base URL of the OrbitHub API, including the version prefix.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Google OAuth. The client id is public by design; the secret stays in the API.
# Provided by the project owner once the Google Cloud console client exists.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=orbithub://auth/google
