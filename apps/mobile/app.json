{
  "expo": {
    "name": "OrbitHub",
    "slug": "orbit-hub",
    "scheme": "orbithub",
    "version": "0.1.26",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#5B7CFA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.orbithub.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.jrzlabs.orbithub",
      "versionCode": 27,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1020"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Hello",
              "label": "OrbitHub",
              "description": "OrbitHub",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "PinnedList",
              "label": "OrbitHub: lista",
              "description": "Una lista de tareas fijada en tu pantalla de inicio",
              "minWidth": "180dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "JournalToday",
              "label": "OrbitHub: diario",
              "description": "La página de hoy de tu diario",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Shortcuts",
              "label": "OrbitHub: atajos",
              "description": "Hasta cuatro sitios de tu espacio a un toque",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Dashboard",
              "label": "OrbitHub: resumen",
              "description": "Lo que tienes pendiente hoy",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "QuickCapture",
              "label": "OrbitHub: captura",
              "description": "Nueva tarea y nueva nota con un toque",
              "minWidth": "180dp",
              "minHeight": "60dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "widgetFeatures": "reconfigurable"
            }
          ]
        }
      ],
      "./plugins/with-upload-signing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B1020"
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain"
            ]
          },
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
