# Variables que se compilan DENTRO del bundle de la release.
#
#   apps/mobile/.env       -> desarrollo: http://localhost:4000/api/v1
#   apps/mobile/.env.local -> overrides de esta maquina
#   este fichero           -> produccion, solo lo lee scripts/release.sh
#
# No lo lee Expo. Es deliberado: Expo carga `.env` y `.env.local` y el ultimo
# gana, asi que un `.env` de produccion rompe el desarrollo local (que hablaria
# con la base de datos real). Aqui la URL entra por el entorno en el momento del
# build, no por un fichero que Expo vaya leyendo por su cuenta.
#
# Por que un fichero y no variables sueltas en el comando: Metro INLINEA cada
# EXPO_PUBLIC_* mientras exporta. El valor acaba dentro del JS, no en el
# entorno del sitio que se sirve. Lo que se ve despues es el bundle.
#
# PUBLICAS. Sin secretos. El secret de Google vive en la API.

# Base de la API, con el prefijo de version. La app une rutas sobre esta base,
# asi que sin /api/v1 pediria https://orbithub-api.jrz-labs.com/auth/login y la
# API responde 404, que en una pantalla de login se lee como "contrasena
# incorrecta" y no como "direccion incorrecta".
EXPO_PUBLIC_API_URL=https://orbithub-api.jrz-labs.com/api/v1

# De donde se sirve la propia app. Es la que aparece en el correo de
# verificacion y en las invitaciones, asi que si se equivoca los enlaces que
# salen en el correo no llevan a ninguna parte.
EXPO_PUBLIC_WEB_ORIGIN=https://orbithub-app.jrz-labs.com

# Client id de Google para OAuth. Publico por diseno; el secret se queda en la
# API. Vacio = el boton de Google sale deshabilitado con una explicacion debajo,
# y no se ve como un fallo sino como una decision del producto.
#
# UNO POR PLATAFORMA, y no son intercambiables. Google rechaza un client de web
# en una app instalada, asi que un build de Android necesita el suyo:
# https://console.cloud.google.com/apis/credentials?project=959281134147
#
#   Android: package com.jrzlabs.orbithub
#            SHA-1  4A:CF:EB:75:5D:06:16:B3:7A:29:E6:21:3F:B7:F3:70:5E:A3:5D:CC
#   iOS:     bundle id com.orbithub.app
#
# El SHA-1 es el de apps/mobile/keys/orbit-hub-upload.jks, no el de la clave con
# la que Google firma. Si el .jks se pierde, esa huella deja de servir para
# Android y hay que crear otro client.
#
# Solo lleva el de Android. El de web lo lee EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB
# desde otro fichero y esta release no se sirve como web.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=

# Solo nativo: el deep link al que vuelve Google. En web el redirect sale de
# window.location.origin y este valor no se usa.
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=orbithub://auth/google