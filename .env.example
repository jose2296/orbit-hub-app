# OrbitHub reads two environment files, not this one:
#
#   apps/api/.env      API configuration and secrets
#   apps/mobile/.env   public app configuration (EXPO_PUBLIC_*)
#
# Create both from their templates with:
#
#   make env-init
#
# This file is kept only as a map. The full inventory, with what each variable
# is for, is in docs/environment.md.

# --- apps/api/.env ----------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
DATABASE_URL=
DATABASE_SSL=false
PGLITE_DATA_DIR=
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_TRANSPORT=console
EMAIL_FROM=no-reply@orbithub.app
WEB_ORIGIN=https://app.orbithub.com
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
AUTH_ACCOUNT_RATE_LIMIT_MAX=5
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_SECRET=
TMDB_API_KEY=
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_SEARCH_ENGINE_ID=

# --- apps/mobile/.env -------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=orbithub://auth/google
