# Shared environment template for the OrbitHub monorepo.
# Copy to `.env` only when you need it locally. Never commit real values.
#
# Mobile reads EXPO_PUBLIC_* variables directly (they are inlined at build time
# and are therefore PUBLIC — never put a secret behind an EXPO_PUBLIC_ prefix).
# The API reads the rest from apps/api/.env.

# --- Mobile (public) -------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_APP_NAME=OrbitHub
# Google OAuth web client id. Provided later by the project owner.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=orbithub://auth/google

# --- API (secret) ---------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma separated list of allowed web origins (Expo web dev server, etc.)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
DATABASE_URL=postgresql://user:password@host:5432/orbit_hub
DATABASE_SSL=false
LOG_LEVEL=info

# Auth
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_FROM=no-reply@orbithub.app
